# Copier ce fichier en .env sur le VPS dans /opt/mise-en-commun/
# Ne jamais commiter le .env rempli

APP_NAME=Mises en Commun
APP_DOMAIN=ton-domaine.com

DOCKER_USERNAME=brandoniscoding

# Base de données (doit correspondre à docker-compose.prod.yml)
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://misescommun:change-me-strong-password@postgres:5432/misescommun

# Redis
REDIS_URL=redis://redis:6379/0

# JWT — générer avec: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-use-a-long-random-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS — mettre le vrai domaine en prod
ALLOWED_ORIGINS=["https://ton-domaine.com"]

DEBUG=false
